    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet combinedResults = [];\n\nfor (const item of items) {\n  if (item.json.results && Array.isArray(item.json.results)) {\n    combinedResults.push(...item.json.results);\n  }\n}\n\nreturn combinedResults.map(res => {\n  const url = res.url || \"\";\n  const rawTitle = res.title || \"\";\n  const candidateName = rawTitle.split(/[-–|:•]/)[0].trim();\n\n  let fuente = \"Web\";\n  if (url.includes(\"linkedin.com\")) fuente = \"LinkedIn\";\n  else if (url.includes(\"getonbrd.com\")) fuente = \"Get on Board\";\n  else if (url.includes(\"torre.ai\")) fuente = \"Torre\";\n\n  return {\n    json: {\n      nombre_candidato: candidateName || \"Candidato Externo\",\n      perfil_url: url,\n      extracto: res.content || \"\",\n      fuente: fuente,\n      origen: \"Externo\"\n    }\n  };\n});"
      },
